    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Server",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "cwd": "${workspaceFolder}",
            "env": {},
            "buildFlags": "-tags debug",
            "args": [
                "-domain=dev.domain.com",
                "-httpAddr=:8002",
                "-httpsAddr=:9082",
                "-tunnelAddr=:4443"
            ],
            "program": "${workspaceFolder}/cmd/ngrokd"
        },
        {
            "name": "Launch Client",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "cwd": "${workspaceFolder}",
            "env": {},
            "buildFlags": "-tags debug",
            "args": [
                "-subdomain",
                "qjw",
                "-proto=http",
                "-config=./config/ngrok.cfg",
                "54321"
            ],
            "program": "${workspaceFolder}/cmd/ngrok"
        }
    ]
}